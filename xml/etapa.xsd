<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.uniovi.es"
           xmlns="http://www.uniovi.es"
           elementFormDefault="qualified">

	<!-- Restricciones-->
	<xs:simpleType name="tipoRangoLatitud">
		<xs:restriction base="xs:decimal">
			<xs:minInclusive value="-90.0" />
			<xs:maxInclusive value="90.0" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="tipoRangoLongitud">
		<xs:restriction base="xs:decimal">
			<xs:minInclusive value="-180.0" />
			<xs:maxInclusive value="180.0" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="tipoCategoriaPuerto">
		<xs:restriction base="xs:string">
			<xs:enumeration value="Especial" />
			<xs:enumeration value="1ª" />
			<xs:enumeration value="2ª" />
			<xs:enumeration value="3ª" />
			<xs:enumeration value="4ª" />
		</xs:restriction>
	</xs:simpleType>

	
	<!-- Elementos con atributos -->
	<xs:element name="longitud_etapa">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:decimal">
					<xs:attribute name="unidad" type="xs:string" use="required" />
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>

	<xs:element name="velocidad_media">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:decimal">
					<xs:attribute name="unidad" type="xs:string" use="required" />
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>

	<xs:element name="desnivel">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:decimal">
					<xs:attribute name="unidad" type="xs:string" use="required" />
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>

	<xs:element name="distancia_salida">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:decimal">
					<xs:attribute name="unidad" type="xs:string" use="required" />
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>

	<xs:element name="altitud">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:decimal">
					<xs:attribute name="unidad" type="xs:string" use="required" />
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>

	<xs:element name="latitud_geo">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="tipoRangoLatitud">
					<xs:attribute name="unidad" type="xs:string" use="required" />
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>

	<xs:element name="longitud_geo">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="tipoRangoLongitud">
					<xs:attribute name="unidad" type="xs:string" use="required" />
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>

	
	<!-- Estructura Principal -->
	<xs:element name="coordenadas">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="longitud_geo" />
				<xs:element ref="latitud_geo" />
				<xs:element ref="altitud" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:element name="inicio">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="ciudad" type="xs:string" />
				<xs:element ref="coordenadas" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:element name="meta">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="ciudad" type="xs:string" />
				<xs:element ref="coordenadas" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:element name="puerto_montana">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="nombre_hito" type="xs:string" />
				<xs:element name="categoria" type="tipoCategoriaPuerto" />
				<xs:element ref="coordenadas" />
				<xs:element ref="distancia_salida" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:element name="sprint">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="nombre_hito" type="xs:string" />
				<xs:element name="tipo_sprint" type="xs:string" />
				<xs:element ref="coordenadas" />
				<xs:element ref="distancia_salida" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:element name="etapa">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="nombre" type="xs:string" />
				<xs:element name="numero" type="xs:positiveInteger" />
				<xs:element ref="longitud_etapa" />
				<xs:element name="fecha" type="xs:date" />
				<xs:element name="tiempo_ganador" type="xs:duration" />
				<xs:element ref="velocidad_media" />
				<xs:element ref="desnivel" />
				<xs:element ref="inicio" />
				<xs:element ref="meta" />
				<xs:element name="tipo" type="xs:string" />

				<xs:element name="referencias">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="referencia" type="xs:anyURI" minOccurs="3" maxOccurs="unbounded" />
						</xs:sequence>
					</xs:complexType>
				</xs:element>

				<xs:element name="galeria_fotografias">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="fotografia" type="xs:string" minOccurs="1" maxOccurs="5" />
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="galeria_videos" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="video" type="xs:string" minOccurs="1" maxOccurs="3" />
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="galeria_audios" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="audio" type="xs:string" minOccurs="1" maxOccurs="3" />
						</xs:sequence>
					</xs:complexType>
				</xs:element>

				<xs:element name="hitos">
					<xs:complexType>
						<xs:choice minOccurs="0" maxOccurs="unbounded">
							<xs:element ref="puerto_montana" />
							<xs:element ref="sprint" />
						</xs:choice>
					</xs:complexType>
				</xs:element>

				<xs:element name="puntos_anonimos">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="punto_anonimo" minOccurs="0" maxOccurs="unbounded">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="nombre_punto" type="xs:string" minOccurs="0" />
										<xs:element ref="coordenadas" />
										<xs:element ref="distancia_salida" />
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>

				<xs:element name="clasificacion_etapa" type="tipoClasificacion" />
				<xs:element name="clasificacion_general" type="tipoClasificacion" />
				<xs:element name="clasificacion_equipos" type="tipoClasificacionEquipos" />

			</xs:sequence>
		</xs:complexType>
	</xs:element>


	<!-- Tipos Complejos -->
	<xs:complexType name="tipoClasificacion">
		<xs:sequence>
			<xs:element name="primero">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="nombre_participante" type="xs:string" />
						<xs:element name="tiempo" type="xs:duration" />
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="segundo">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="nombre_participante" type="xs:string" />
						<xs:element name="diferencia" type="xs:duration" />
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="tercero">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="nombre_participante" type="xs:string" />
						<xs:element name="diferencia" type="xs:duration" />
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="tipoClasificacionEquipos">
		<xs:sequence>
			<xs:element name="equipo_primero">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="nombre_equipo" type="xs:string" />
						<xs:element name="tiempo" type="xs:duration" />
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="equipo_segundo">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="nombre_equipo" type="xs:string" />
						<xs:element name="diferencia" type="xs:duration" />
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="equipo_tercero">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="nombre_equipo" type="xs:string" />
						<xs:element name="diferencia" type="xs:duration" />
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

</xs:schema>
