<!ELEMENT etapa (nombre, numero, longitud_etapa, fecha, tiempo_ganador, velocidad_media, desnivel, inicio, meta, tipo, referencias, galeria_fotografias, galeria_videos, galeria_audios, hitos, puntos_anonimos, clasificacion_etapa, clasificacion_general, clasificacion_equipos)>

<!--ETAPA-->
<!ELEMENT nombre (#PCDATA)>
<!ELEMENT numero (#PCDATA)>
<!ELEMENT longitud_etapa (#PCDATA)>
<!ATTLIST longitud_etapa unidad CDATA #REQUIRED>
<!ELEMENT fecha (#PCDATA)>
<!ELEMENT tiempo_ganador (#PCDATA)>
<!ELEMENT velocidad_media (#PCDATA)>
<!ATTLIST velocidad_media unidad CDATA #REQUIRED>
<!ELEMENT desnivel (#PCDATA)>
<!ATTLIST desnivel unidad CDATA #REQUIRED>
<!ELEMENT tipo (#PCDATA)>

<!--INICIO Y META-->
<!ELEMENT inicio (ciudad, coordenadas)>
<!ELEMENT meta (ciudad, coordenadas)>
<!ELEMENT ciudad (#PCDATA)>

<!--COORDENADAS-->
<!ELEMENT coordenadas (longitud_geo, latitud_geo, altitud)>
<!ELEMENT longitud_geo (#PCDATA)>
<!ATTLIST longitud_geo unidad CDATA #REQUIRED>
<!ELEMENT latitud_geo (#PCDATA)>
<!ATTLIST latitud_geo unidad CDATA #REQUIRED>
<!ELEMENT altitud (#PCDATA)>
<!ATTLIST altitud unidad CDATA #REQUIRED>

<!--REFERENCIAS-->
<!ELEMENT referencias (referencia, referencia, referencia, referencia*)>
<!ELEMENT referencia (#PCDATA)>

<!--GALERIA FOTOS-->
<!ELEMENT galeria_fotografias (fotografia, fotografia?, fotografia?, fotografia?, fotografia?)>
<!ELEMENT fotografia (#PCDATA)>
<!--GALERIA VIDEOS-->
<!ELEMENT galeria_videos (video, video?, video?)>
<!ELEMENT video (#PCDATA)>
<!--GALERIA AUDIOS-->
<!ELEMENT galeria_audios (audio, audio?, audio?)>
<!ELEMENT audio (#PCDATA)>

<!--HITOS-->
<!ELEMENT hitos (puerto_montana | sprint)*>
<!ELEMENT puerto_montana (nombre_hito, categoria, coordenadas, distancia_salida)>
<!ELEMENT sprint (nombre_hito,tipo_sprint, coordenadas, distancia_salida)>
<!ELEMENT nombre_hito (#PCDATA)>
<!ELEMENT categoria (#PCDATA)>
<!ELEMENT tipo_sprint (#PCDATA)>

<!ELEMENT distancia_salida (#PCDATA)>
<!ATTLIST distancia_salida unidad CDATA #REQUIRED>

<!--PUNTOS ANÓNIMOS-->
<!ELEMENT puntos_anonimos (punto_anonimo*)>
<!ELEMENT punto_anonimo (nombre_punto?, coordenadas, distancia_salida)>
<!ELEMENT nombre_punto (#PCDATA)>

<!--CLASIFICACIONES-->
<!ELEMENT clasificacion_etapa (primero, segundo, tercero)>
<!ELEMENT clasificacion_general (primero, segundo, tercero)>
<!ELEMENT clasificacion_equipos (equipo_primero, equipo_segundo, equipo_tercero)>

<!ELEMENT primero (nombre_participante, tiempo)>
<!ELEMENT segundo (nombre_participante, diferencia)>
<!ELEMENT tercero (nombre_participante, diferencia)>

<!ELEMENT equipo_primero (nombre_equipo, tiempo)>
<!ELEMENT equipo_segundo (nombre_equipo, diferencia)>
<!ELEMENT equipo_tercero (nombre_equipo, diferencia)>

<!--ELEMENTOS CLASIFICACIONES-->
<!ELEMENT nombre_participante (#PCDATA)>
<!ELEMENT nombre_equipo (#PCDATA)>
<!ELEMENT tiempo (#PCDATA)>
<!ELEMENT diferencia (#PCDATA)>